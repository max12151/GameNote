# Copier ce fichier en `.env` (ignoré par git) et compléter.
# docker compose lit .env automatiquement, aucun réglage supplémentaire n'est nécessaire.

# --- IGDB ------------------------------------------------------------------------
# Application Twitch : https://dev.twitch.tv/console/apps
# Sans ces deux valeurs le site fonctionne, mais la recherche de jeux, la page Découvrir
# et les sorties à venir de l'accueil restent indisponibles.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Signature des jetons ---------------------------------------------------------
# 32 octets minimum. La valeur par défaut du compose suffit pour développer ; en changer
# invalide les sessions ouvertes.
# JWT_SECRET=

# --- Base de données --------------------------------------------------------------
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
